  "devDependencies": {
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^25.6.0",
    "@types/node-fetch": "^2.6.13",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo-typescript": "^11.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "xo": "^2.0.2"
  },
  "xo": {
    "prettier": true,
    "space": false,
    "semicolon": true,
    "rules": {
      "@typescript-eslint/naming-convention": [
        "error",
        {
          "selector": "variable",
          "format": ["camelCase", "UPPER_CASE"],
          "leadingUnderscore": "allow"
        },
        {
          "selector": "parameter",
          "format": ["camelCase"],
          "leadingUnderscore": "allow"
        },
        {
          "selector": "typeLike",
          "format": ["PascalCase"]
        }
      ]
    }
  }
}
